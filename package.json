{
  "name": "@local/dsh-deepseek-balance",
  "version": "1.2.0",
  "private": true,
  "description": "DeepSeek account balance in the Harness Web composer status line",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/captainni/dsh-deepseek-balance.git"
  },
  "homepage": "https://github.com/captainni/dsh-deepseek-balance#readme",
  "bugs": {
    "url": "https://github.com/captainni/dsh-deepseek-balance/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "balance",
    "deepseek"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
